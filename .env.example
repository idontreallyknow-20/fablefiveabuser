# Orbit environment template
# Copy to .env.local for development. Set the same values in Vercel for production.

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (secret). Required for Spotify/Google token storage and
# calendar sync. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
# Public registration. Set true to let anyone create their own account from
# the login screen. Set false to keep Orbit personal — the very first account
# can always be created (bootstrap), even when this is false.
PUBLIC_SIGNUPS_ENABLED=true
# Base URL of the deployed app, used for OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Spotify (optional, enables the player) --------------------------------
# Create an app at https://developer.spotify.com/dashboard with redirect URI
# {NEXT_PUBLIC_APP_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Google Calendar (optional, enables calendar sync) ----------------------
# Create OAuth credentials at https://console.cloud.google.com with redirect
# URI {NEXT_PUBLIC_APP_URL}/api/google/callback and the Calendar API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (optional, off by default) ------------------------------------------
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_FEATURES_ENABLED=false

# --- Web push (optional, enables background notifications) ------------------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:helloilovechess@gmail.com
