# Orbit environment template. Copy to .env.local for development.
# Orbit needs no configuration to run: all data lives in the browser.

# Canonical site URL for metadata, sitemap and social cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI assistant (optional, off unless a key is set) -----------------------
# The assistant endpoint is public, so anyone using the site spends from this
# key. Leave it empty unless you're happy to pay for that.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
